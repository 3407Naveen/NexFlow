# NexFlow Backend Environment Variables
# Copy to .env and fill in your values

# === General ===
APP_NAME=NexFlow
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# === Database ===
DATABASE_URL=postgresql+asyncpg://nexflow:nexflow_dev_pass@localhost:5432/nexflow
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Security ===
SECRET_KEY=change-this-to-a-random-string-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === OpenAI ===
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# === S3 / MinIO ===
S3_BUCKET=nexflow-files
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=nexflow_access
S3_SECRET_KEY=nexflow_secret

# === Clerk Auth (optional, for production) ===
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# === CORS ===
CORS_ORIGINS=["http://localhost:3000"]

# === Cost Governance ===
PER_ORG_MONTHLY_TOKEN_BUDGET=1000000
PER_WORKFLOW_RUN_TOKEN_CAP=50000

# === Approval ===
APPROVAL_EXPIRY_HOURS=24

# === Knowledge ===
KNOWLEDGE_CHUNK_SIZE=500
KNOWLEDGE_CHUNK_OVERLAP=50

# === Demo Mode ===
DEMO_MODE=true
